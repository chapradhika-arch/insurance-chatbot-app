# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. `.env.example` is committed — NEVER put real secrets here.

# Cohere API key from https://dashboard.cohere.com (POC only — upgrade for production).
# This is the ENV VAR NAME the backend reads; the dashboard label you give the key
# (e.g. "insurance-chatbot-api-trial-key") is unrelated to this name.
COHERE_API_KEY=replace-with-your-cohere-key

# Cohere model IDs (override only if you know what you're doing)
COHERE_CHAT_MODEL=command-r-plus-08-2024
COHERE_EMBED_MODEL=embed-english-v3.0

# CORS — comma-separated list of allowed Angular dev/prod origins
CORS_ORIGINS=http://localhost:4200

# Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
